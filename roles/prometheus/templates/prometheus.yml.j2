global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - localhost:9090

  - job_name: node_exporter
    static_configs:
      - targets:
          - 192.168.40.9:9100
          - 192.168.40.10:9100
          - 192.168.40.11:9100
          - 192.168.40.12:9100
          - 192.168.40.13:9100
          - 192.168.40.14:9100
